{% extends 'base.html.twig' %}
{% block title %}Mon Club - {{ club.name }}{% endblock %}
{% block body %}
<div class="container mt-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}

    <div class="row mb-4">
        <div class="col-md-3 text-center">
            {% if club.logo %}
                <img src="{{ asset('uploads/clubs/' ~ club.logo) }}"
                     class="rounded-circle mb-2" width="120" height="120" style="object-fit:cover">
            {% else %}
                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-2"
                     style="width:120px;height:120px">
                    <span class="text-white fs-1">🏛️</span>
                </div>
            {% endif %}
            <h4>{{ club.name }}</h4>
            <span class="badge bg-primary">{{ role }}</span>
        </div>

        <div class="col-md-9">
            <h1>Tableau de bord — Mon Club</h1>
            <p class="text-muted">{{ club.description }}</p>

            {% if isManager %}
            <div class="row mt-3">
                <div class="col-md-4 mb-3">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3>{{ members|length }}</h3>
                            <p>Membres</p>
                            <a href="#members" class="btn btn-sm btn-outline-primary">Gérer</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3>{{ recrutements|length }}</h3>
                            <p>Recrutements</p>
                            <a href="{{ path('app_recrutement_create') }}" class="btn btn-sm btn-outline-success">Ajouter</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3>📅</h3>
                            <p>Événements</p>
                            <a href="{{ path('app_evenement_create') }}" class="btn btn-sm btn-outline-warning">Ajouter</a>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {# Members section #}
    <div class="card mb-4" id="members">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">👥 Membres du club</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for member in members %}
                    <tr>
                        <td>{{ member.user.firstname }} {{ member.user.lastname }}</td>
                        <td>{{ member.user.email }}</td>
                        <td>{{ member.role }}</td>
                        <td>
                            <span class="badge bg-{{ member.status == 'approved' ? 'success' : 'warning' }}">
                                {{ member.status }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Recrutements section #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">💼 Recrutements</h5>
            {% if isManager %}
            <a href="{{ path('app_recrutement_create') }}" class="btn btn-sm btn-success">+ Nouveau</a>
            {% endif %}
        </div>
        <div class="card-body">
            {% if recrutements is empty %}
                <p class="text-muted">Aucun recrutement pour le moment.</p>
            {% else %}
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Titre</th>
                            <th>Deadline</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for recrutement in recrutements %}
                        <tr>
                            <td>{{ recrutement.title }}</td>
                            <td>{{ recrutement.deadline ? recrutement.deadline|date('d/m/Y') : 'N/A' }}</td>
                            <td>
                                <span class="badge bg-{{ recrutement.status == 'validated' ? 'success' : 'warning' }}">
                                    {{ recrutement.status }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_recrutement_show', {id: recrutement.id}) }}" 
                                   class="btn btn-sm btn-primary">Voir</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    {% if isManager %}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">⚙️ Gestion du club</h5>
        </div>
        <div class="card-body">
            <a href="{{ path('app_club_edit', {id: club.id}) }}" class="btn btn-warning me-2">
                ✏️ Modifier les infos du club
            </a>
            <a href="{{ path('app_admin_candidatures') }}" class="btn btn-info me-2">
                📋 Gérer les candidatures
            </a>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}