{% extends 'base.html.twig' %}
{% block title %}Vérification Du Compte{% endblock %}
{% block body %}
<div class="container mt-5" style="max-width:400px">
    <div class="card shadow">
        <div class="card-body text-center p-4">
            <h2 class="mb-2">🔐 Vérification</h2>
            <p class="text-muted mb-4">
                {% if context == 'login' %}
                    Un code de connexion a été envoyé à votre email.
                {% else %}
                    Un code de vérification a été envoyé à votre email.
                {% endif %}
            </p>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post">
                <div class="mb-3">
                    <input type="text" 
                           name="otp_code" 
                           class="form-control form-control-lg text-center" 
                           placeholder="000000"
                           maxlength="6"
                           autofocus
                           style="letter-spacing: 8px; font-size: 28px">
                </div>
                <button type="submit" class="btn btn-primary w-100">Vérifier</button>
            </form>

            <p class="mt-3 text-muted small">Code expiré ? 
                <a href="{{ path('app_otp_verify') }}">Renvoyer</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}