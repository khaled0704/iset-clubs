{% extends 'base.html.twig' %}

{% block title %}Vérification | ISET Events{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="iset-form text-center">
                <div class="mb-4">
                    <div class="iset-hero" style="padding: 1rem; background: linear-gradient(135deg, var(--iset-dark-blue) 0%, var(--iset-blue) 100%); border-radius: 1rem; margin-bottom: 1.5rem;">
                        <span class="display-1">🛡️</span>
                    </div>
                    <h1 class="display-5 fw-bold mt-2" style="color: var(--iset-dark-blue);">Vérification</h1>
                    <p class="text-muted">
                        {% if context == 'login' %}
                            Un code de connexion à 6 chiffres a été envoyé à votre adresse email.
                        {% else %}
                            Un code de vérification à 6 chiffres a été envoyé à votre adresse email.
                        {% endif %}
                    </p>
                </div>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    {% for i in 1..6 %}
                        <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--iset-blue); opacity: 0.3;"></div>
                    {% endfor %}
                </div>

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger border-0 shadow-sm" style="border-left: 5px solid var(--iset-red) !important;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> {{ message }}
                    </div>
                {% endfor %}
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success border-0 shadow-sm" style="border-left: 5px solid var(--iset-success) !important;">
                        <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
                    </div>
                {% endfor %}

                <form method="post">
                    <div class="mb-4">
                        <input type="text"
                               name="otp_code"
                               class="form-control text-center"
                               placeholder="000000"
                               maxlength="6"
                               autofocus
                               style="font-size: 2rem; letter-spacing: 0.5rem; font-weight: 600; font-family: monospace;">
                    </div>
                    <button type="submit" class="btn-iset-primary w-100 py-2">
                        ✅ Vérifier le code
                    </button>
                </form>

                <p class="mt-4 text-muted small">
                    Code expiré ? <a href="{{ path('app_otp_verify') }}" style="color: var(--iset-blue);">Renvoyer un nouveau code</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}