{% extends 'base.html.twig'%}
{% block title %} Créer un événement{% endblock %}
{% block body%}
<div class="container mt-4" style="max-width: 700px">
    <h1 class="mb-4">📅 Créer un événement</h1>
    {{form_start(form,{'attr':{'enctype':'multipart/form-data'}}) }}
        <div class="mb-3">
            {{ form_label(form.nomEvenement)}}
            {{ form_widget(form.nomEvenement)}}
        </div>
         <div class="mb-3">
            {{ form_label(form.dateDebut) }}
            {{ form_widget(form.dateDebut) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.dateFin) }}
            {{ form_widget(form.dateFin) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.lieu) }}
            {{ form_widget(form.lieu) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile) }}
        </div>
        <button type="submit" class="btn btn-primary w-100">Créer l'événement</button>
    {{ form_end(form) }}

    <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary mt-3">← Retour</a>
</div>
{% endblock %}