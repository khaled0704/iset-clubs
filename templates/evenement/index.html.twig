{% extends 'base.html.twig' %}

{% block title %}ISET Events – Vie étudiante & conférences tech{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
    {# Hero Section #}
    <div class="iset-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold">📅 Événements <span style="color: var(--iset-red);">ISET</span></h1>
                    <p class="lead mt-3 opacity-90">
                        Conférences, hackathons, forums de l'emploi et ateliers pratiques<br>
                        
                    </p>
                    
                </div>
                <div class="col-lg-4 d-none d-lg-block text-end">
                    <span class="display-1">🇹🇳</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success border-0 shadow-sm" style="border-left: 5px solid var(--iset-success) !important;">
                <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
            </div>
        {% endfor %}

         
            
            
 
        {% if evenements is empty %}
            <div class="text-center py-5 my-5">
                <div class="display-1 mb-3">📭</div>
                <h3 class="fw-semibold">Aucun événement pour le moment</h3>
                <p class="text-muted">Soyez le premier à organiser un événement dans votre ISET</p>
                <a href="{{ path('app_evenement_new') }}" class="btn-iset-primary mt-2 text-decoration-none">
                    ➕ Créer un événement
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for event in evenements %}
                <div class="col-md-6 col-lg-4">
                    <div class="iset-card h-100">
                        {% if event.image %}
                            <img src="/uploads/events/{{ event.image }}" class="iset-card-img w-100" alt="{{ event.nomEvenement }}">
                        {% else %}
                            <div class="iset-card-img w-100 d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                                <span class="display-3 text-muted">🎓</span>
                            </div>
                        {% endif %}
                        
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="iset-badge iset-badge-tech">📅 À venir</span>
                                <small class="text-muted">{{ event.dateDebut|date('d/m') }}</small>
                            </div>
                            
                            <h5 class="fw-bold mb-2" style="color: var(--iset-dark-blue);">{{ event.nomEvenement }}</h5>
                            
                            <div class="small text-muted mb-3">
                                <div><i class="bi bi-geo-alt"></i> 📍 {{ event.lieu }}</div>
                                <div><i class="bi bi-calendar"></i> 🗓️ {{ event.dateDebut|date('d/m/Y H:i') }}</div>
                            </div>
                            
                            <p class="small mb-3" style="color: var(--iset-text);">
                                {{ event.description|striptags|slice(0, 90) }}...
                            </p>
                            
                            <a href="{{ path('app_evenement_show', {id: event.id}) }}" 
                               class="btn-iset-outline w-100 text-center d-block py-2 text-decoration-none">
                                Voir les détails →
                            </a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    
{% endblock %}