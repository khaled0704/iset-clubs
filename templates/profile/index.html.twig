{% extends 'base.html.twig' %}

{% block title %}Mon Profil | ISET Clubs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="iset-form text-center">
                
                <div class="mb-4">
                    <div class="iset-hero" style="padding: 2rem; margin-bottom: 1.5rem;">
                        <span class="display-1">👤</span>
                    </div>
                    
                    {% if user.profilepicture %}
                        <img src="/uploads/profiles/{{ user.profilepicture }}" 
                             class="rounded-circle" width="120" height="120" style="object-fit:cover; border: 4px solid var(--iset-blue);">
                    {% else %}
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center" 
                             style="width:120px;height:120px; background: linear-gradient(135deg, var(--iset-blue), var(--iset-blue-dark)); border: 4px solid var(--iset-blue-light);">
                            <span class="text-white fs-1">{{ user.firstname|first }}{{ user.lastname|first }}</span>
                        </div>
                    {% endif %}
                    
                    <h2 class="mt-3 fw-bold" style="color: var(--iset-dark-blue);">{{ user.firstname }} {{ user.lastname }}</h2>
                    <p class="text-muted">{{ user.email }}</p>
                </div>

                <hr class="iset-divider">

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success border-0 shadow-sm" style="border-left: 5px solid var(--iset-success) !important;">
                        <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'text-start'}}) }}
                    
                    <div class="mb-4">
                        {{ form_label(form.firstname, "Prénom", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(form.firstname, {'attr': {'class': 'form-control'}})}}
                    </div>
                    
                    <div class="mb-4">
                        {{ form_label(form.lastname, "Nom", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(form.lastname, {'attr': {'class': 'form-control'}})}}
                    </div>
                    
                    <div class="mb-4">
                        {{ form_label(form.phonenumber, "Téléphone", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(form.phonenumber, {'attr': {'class': 'form-control', 'placeholder': '+216 XX XXX XXX'}})}}
                    </div>
                    
                    <div class="mb-4">
                        {{ form_label(form.profilePictureFile, "Photo de profil", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(form.profilePictureFile, {'attr': {'class': 'form-control'}})}}
                        <div class="form-text">Formats acceptés : JPG, PNG</div>
                    </div>
                    
                    <button type="submit" class="btn-iset-primary w-100 py-2">
                        💾 Enregistrer les modifications
                    </button>
                    
                {{ form_end(form) }}

                <div class="mt-4">
                    <a href="{{ path('app_home') }}" class="btn-iset-outline text-decoration-none px-4 py-2">
                        ← Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}