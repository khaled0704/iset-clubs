{% extends 'base.html.twig' %}

{% block title %}{{ recrutement.title }} | ISET Events{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-4">
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success border-0 shadow-sm">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning border-0 shadow-sm">{{ message }}</div>
    {% endfor %}

    {% set isClubManager = false %}
    {% for member in recrutement.club.clubMembers %}
        {% if member.user == app.user and member.status == 'approved' and member.role in ['President', 'Responsable'] %}
            {% set isClubManager = true %}
        {% endif %}
    {% endfor %}

    <div class="iset-event-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <span class="iset-badge iset-badge-tech" style="background: var(--iset-blue);">🎯 Offre de recrutement</span>
                <h1 class="display-5 fw-bold mt-2">{{ recrutement.title }}</h1>
                <div class="mt-2">
                    <i class="bi bi-building"></i> <strong>{{ recrutement.club.name }}</strong>
                    &nbsp;|&nbsp;
                    <i class="bi bi-calendar"></i> Publié le {{ recrutement.createdAt|date('d/m/Y') }}
                    {% if recrutement.deadline %}
                        &nbsp;|&nbsp;
                        <i class="bi bi-clock"></i> Deadline: {{ recrutement.deadline|date('d/m/Y') }}
                    {% endif %}
                </div>
            </div>
            <div class="text-end">
                <span class="display-6">📢</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="iset-card p-4 mb-4">
                <h3 class="fw-bold mb-3" style="color: var(--iset-dark-blue);">
                    <i class="bi bi-pencil-square"></i> Description du poste
                </h3>
                <div class="lead" style="line-height: 1.7;">
                    {{ recrutement.description|nl2br }}
                </div>
            </div>

            {% if recrutement.requirements %}
            <div class="iset-card p-4">
                <h3 class="fw-bold mb-3" style="color: var(--iset-dark-blue);">
                    <i class="bi bi-check-circle"></i> Prérequis
                </h3>
                <div class="lead" style="line-height: 1.7;">
                    {{ recrutement.requirements|nl2br }}
                </div>
            </div>
            {% endif %}
        </div>

        <div class="col-lg-5">
            {% if is_granted('IS_AUTHENTICATED_FULLY') and not isClubManager %}
                <div class="iset-card p-4 mb-4 iset-participation-card">
                    <h4 class="fw-bold mb-3">🤝 Postuler</h4>
                    {% if alreadyApplied %}
                        <div class="alert alert-success mb-3">
                            <i class="bi bi-check-circle-fill"></i> <strong>Vous avez déjà postulé !</strong><br>
                            <small>Bonne chance pour votre candidature</small>
                        </div>
                    {% else %}
                        <div class="text-center mb-3">
                            <div class="display-4 mb-2">📝</div>
                            <a href="{{ path('app_candidature_postuler', {id: recrutement.id}) }}"
                               class="btn-iset-primary w-100 d-block text-center py-2 text-decoration-none">
                                ✅ Postuler maintenant
                            </a>
                            <small class="text-muted d-block mt-2">Gratuit · Ouvert à tous les étudiants</small>
                        </div>
                    {% endif %}
                </div>
            {% elseif not is_granted('IS_AUTHENTICATED_FULLY') %}
                <div class="iset-card p-4 mb-4 text-center">
                    <i class="bi bi-lock-fill display-6"></i>
                    <p class="mt-2">Connectez-vous pour postuler</p>
                    <a href="{{ path('app_login') }}" class="btn-iset-outline text-decoration-none d-block">
                        🔐 Connexion étudiant
                    </a>
                </div>
            {% endif %}

            {% if alreadyApplied %}
            <div class="iset-card p-4">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-chat-dots"></i> Donnez votre avis
                </h4>
                {{ form_start(feedbackForm) }}
                    <div class="mb-3">
                        {{ form_label(feedbackForm.content, "💬 Votre feedback", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(feedbackForm.content, {'attr': {
                            'class': 'form-control',
                            'rows': 3,
                            'placeholder': 'Ce que vous pensez du recrutement...'
                        }})}}
                    </div>
                    <div class="mb-3">
                        {{ form_label(feedbackForm.rating, "⭐ Note (1-5)", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(feedbackForm.rating, {'attr': {'class': 'form-select'}})}}
                        <div class="form-text">⭐ 1 = À améliorer · ⭐⭐⭐⭐⭐ = Exceptionnel</div>
                    </div>
                    <button type="submit" class="btn-iset-primary w-100 py-2">
                        ✉️ Envoyer mon feedback
                    </button>
                {{ form_end(feedbackForm) }}
            </div>
            {% endif %}
        </div>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_recrutement_index') }}" class="btn-iset-outline text-decoration-none px-4 py-2">
            ← Retour aux recrutements
        </a>
    </div>
</div>
{% endblock %}