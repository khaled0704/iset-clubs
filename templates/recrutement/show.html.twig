{% extends 'base.html.twig' %}
{% block title %}{{ recrutement.title }}{% endblock %}
{% block body %}
<div class="container mt-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h1>{{ recrutement.title }}</h1>
            <p class="text-muted">
                🏢 {{ recrutement.club.name }}<br>
                🗓️ Publié le {{ recrutement.createdAt|date('d/m/Y') }}<br>
                {% if recrutement.deadline %}
                    ⏳ Deadline: {{ recrutement.deadline|date('d/m/Y') }}
                {% endif %}<br>
                📌 Statut: {{ recrutement.status }}
            </p>

            {% if recrutement.description %}
                <h5>Description</h5>
                <p>{{ recrutement.description }}</p>
            {% endif %}

            {% if recrutement.requirements %}
                <h5>Prérequis</h5>
                <p>{{ recrutement.requirements }}</p>
            {% endif %}

            {% if app.user %}
                {% if alreadyApplied %}
                    <div class="alert alert-info">Vous avez déjà postulé.</div>
                {% else %}
                    <a href="{{ path('app_candidature_postuler', {id: recrutement.id}) }}" 
                       class="btn btn-success">Postuler</a>
                {% endif %}
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                    Connectez-vous pour postuler
                </a>
            {% endif %}
        </div>
    </div>

    <div class="mt-4">
    <h3>💬 Feedback</h3>
    {% if app.user %}
        {{ form_start(feedbackForm) }}
            <div class="mb-3">
                {{ form_row(feedbackForm.content) }}
            </div>
            <button type="submit" class="btn btn-outline-primary">Envoyer</button>
        {{ form_end(feedbackForm) }}
    {% else %}
        <div class="alert alert-info">
            <a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un feedback.
        </div>
    {% endif %}
</div>

</div>
{% endblock %}