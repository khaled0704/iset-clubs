{% extends 'base.html.twig' %}
{% block title %}Mes Réclamations{% endblock %}
{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📋 Mes Réclamations</h1>
        <a href="{{ path('app_reclamation_new') }}" class="btn btn-primary">+ Nouvelle réclamation</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% if reclamations is empty %}
        <div class="alert alert-info">Vous n'avez aucune réclamation pour le moment.</div>
    {% else %}
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Sujet</th>
                    <th>Message</th>
                    <th>Statut</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
            {% for reclamation in reclamations %}
                <tr>
                    <td>{{ reclamation.subject }}</td>
                    <td>{{ reclamation.message|slice(0, 80) }}...</td>
                    <td>
                        <span class="badge bg-{{ reclamation.status == 'resolved' ? 'success' : (reclamation.status == 'rejected' ? 'danger' : 'warning') }}">
                            {{ reclamation.status }}
                        </span>
                    </td>
                    <td>{{ reclamation.createdAt|date('d/m/Y') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}