{% extends 'base.html.twig' %}

{% block title %}Mes Candidatures | ISET Clubs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="iset-card" style="padding: 2rem;">
        
        <div class="text-center mb-4">
            <span class="display-1">📋</span>
            <h1 class="display-5 fw-bold mt-2" style="color: var(--iset-dark-blue);">Mes Candidatures</h1>
            <p class="text-muted">Suivez l'état de vos candidatures</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success border-0 shadow-sm">{{ message }}</div>
        {% endfor %}

        {% if candidatures is empty %}
            <div class="text-center py-5">
                <div class="display-1 mb-3">📭</div>
                <p class="text-muted">Vous n'avez aucune candidature pour le moment.</p>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead style="background: var(--iset-dark-blue);">
                        <tr>
                            <th>Référence</th>
                            <th>Recrutement</th>
                            <th>Club</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th>CV</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for candidature in candidatures %}
                        <tr>
                            <td><small>{{ candidature.no }}</small></td>
                            <td>{{ candidature.recrutement.title }}</td>
                            <td>{{ candidature.recrutement.club.name }}</td>
                            <td>
                                <span class="iset-badge {{ candidature.status == 'accepted' ? 'iset-badge-success' : (candidature.status == 'rejected' ? '' : 'iset-badge-warning') }}" 
                                      style="background: {{ candidature.status == 'accepted' ? 'var(--iset-success)' : (candidature.status == 'rejected' ? 'var(--iset-red)' : 'var(--iset-warning)') }}; color: white;">
                                    {{ candidature.status }}
                                </span>
                            </td>
                            <td>{{ candidature.submittedAt|date('d/m/Y') }}</td>
                            <td>
                                {% if candidature.cvFilename %}
                                    <a href="/uploads/cvs/{{ candidature.cvFilename }}" target="_blank" style="color: var(--iset-blue-light);">📄 Voir CV</a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}