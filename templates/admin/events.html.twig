{% extends 'base.html.twig' %}

{% block title %}Gestion Événements | Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="iset-card" style="padding: 2rem;">
        
        <div class="text-center mb-4">
            <span class="display-1">📅</span>
            <h1 class="display-5 fw-bold mt-2" style="color: var(--iset-dark-blue);">Gestion des Événements</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success border-0 shadow-sm">{{ message }}</div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-dark table-hover">
                <thead style="background: var(--iset-dark-blue);">
                    <tr><th>Nom</th><th>Date début</th><th>Lieu</th><th>Statut</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    {% for event in events %}
                    <tr>
                        <td>{{ event.nomEvenement }}</td>
                        <td>{{ event.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ event.lieu }}</td>
                        <td>
                            <span class="iset-badge" style="background: {{ event.status == 'validated' ? 'var(--iset-success)' : (event.status == 'rejected' ? 'var(--iset-red)' : 'var(--iset-warning)') }}; color: white;">
                                {{ event.status }}
                            </span>
                        </td>
                        <td>
                            {% if event.status != 'validated' %}
                                <a href="{{ path('app_admin_validate_event', {id: event.id}) }}" class="btn-iset-primary btn-sm">Valider</a>
                            {% endif %}
                            {% if event.status != 'rejected' %}
                                <a href="{{ path('app_admin_reject_event', {id: event.id}) }}" class="btn-iset-danger btn-sm">Refuser</a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="text-center mt-4">
            <a href="{{ path('app_admin') }}" class="btn-iset-outline text-decoration-none px-4 py-2">← Retour</a>
        </div>
    </div>
</div>
{% endblock %}