{% extends 'base.html.twig' %}

{% block title %}Demandes d'adhésion | Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="iset-card" style="padding: 2rem;">
        
        <div class="text-center mb-4">
            <span class="display-1">👥</span>
            <h1 class="display-5 fw-bold mt-2" style="color: var(--iset-dark-blue);">Demandes d'adhésion aux clubs</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success border-0 shadow-sm">{{ message }}</div>
        {% endfor %}

        {% if pendingMembers is empty %}
            <div class="text-center py-5">
                <div class="display-1 mb-3">✅</div>
                <p class="text-muted">Aucune demande en attente.</p>
            </div>
        {% else %}
            <div class="table-responsive">
               <table class="table table-hover">
    <thead style="background: var(--iset-dark-blue); color: white;">
                        <tr>
                            <th>Étudiant</th>
                            <th>Club</th>
                            <th>Date demande</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for member in pendingMembers %}
                            <tr>
                                <td>{{ member.user.firstname }} {{ member.user.lastname }}</td>
                                <td>{{ member.club.name }}</td>
                                <td>{{ member.joinedAt|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('app_admin_approve_member', {id: member.id}) }}" class="btn-iset-primary btn-sm" style="padding: 0.25rem 0.75rem;">Approuver</a>
                                    <a href="{{ path('app_admin_reject_member', {id: member.id}) }}" class="btn-iset-danger btn-sm" style="padding: 0.25rem 0.75rem;">Refuser</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <div class="text-center mt-4">
            <a href="{{ path('app_admin') }}" class="btn-iset-outline text-decoration-none px-4 py-2">← Retour</a>
        </div>
    </div>
</div>
{% endblock %}