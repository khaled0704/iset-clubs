{% extends 'base.html.twig' %}
{% block title %}Admin Dashboard | ISET Clubs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="text-center mb-5">
        <span class="display-1">👨‍💼</span>
        <h1 class="display-4 fw-bold mt-2" style="color: var(--iset-dark-blue);">Admin Dashboard</h1>
        <p class="text-muted">Vue d'ensemble — ISET Clubs</p>
    </div>

    {# Stats #}
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="iset-card p-3 text-center">
                <div class="fw-bold" style="font-size:2rem; color: var(--iset-dark-blue);">{{ totalUsers }}</div>
                <div class="small text-muted">Utilisateurs</div>
                {% if totalPendingUsers > 0 %}
                    <span class="iset-badge mt-1 d-inline-block" style="background: var(--iset-red); color:white;">{{ totalPendingUsers }} en attente</span>
                {% endif %}
            </div>
        </div>
        <div class="col-md-2">
            <div class="iset-card p-3 text-center">
                <div class="fw-bold" style="font-size:2rem; color: var(--iset-dark-blue);">{{ totalClubs }}</div>
                <div class="small text-muted">Clubs</div>
                {% if totalPendingClubs > 0 %}
                    <span class="iset-badge mt-1 d-inline-block" style="background: var(--iset-red); color:white;">{{ totalPendingClubs }} en attente</span>
                {% endif %}
            </div>
        </div>
        <div class="col-md-2">
            <div class="iset-card p-3 text-center">
                <div class="fw-bold" style="font-size:2rem; color: var(--iset-dark-blue);">{{ totalEvents }}</div>
                <div class="small text-muted">Événements</div>
                {% if totalPendingEvents > 0 %}
                    <span class="iset-badge mt-1 d-inline-block" style="background: var(--iset-red); color:white;">{{ totalPendingEvents }} en attente</span>
                {% endif %}
            </div>
        </div>
        
        <div class="col-md-2">
            <div class="iset-card p-3 text-center">
                <div class="fw-bold" style="font-size:2rem; color: var(--iset-dark-blue);">{{ totalReclamations }}</div>
                <div class="small text-muted">Réclamations</div>
                {% if totalPendingReclamations > 0 %}
                    <span class="iset-badge mt-1 d-inline-block" style="background: var(--iset-red); color:white;">{{ totalPendingReclamations }} en attente</span>
                {% endif %}
            </div>
        </div>
         
    </div>

    {# Recent tables #}
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="iset-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color: var(--iset-dark-blue);">👥 Derniers utilisateurs</h5>
                    <a href="{{ path('app_admin_users') }}" style="color: var(--iset-blue); font-size:13px;">Voir tout →</a>
                </div>
                {% for user in recentUsers %}
                <div class="d-flex align-items-center gap-3 py-2" style="border-bottom: 1px solid var(--iset-border);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:36px; height:36px; background: linear-gradient(135deg, var(--iset-blue), var(--iset-dark-blue));">
                        <span class="text-white small fw-bold">{{ user.firstname|first|upper }}{{ user.lastname|first|upper }}</span>
                    </div>
                    <div>
                        <div class="fw-semibold small">{{ user.firstname }} {{ user.lastname }}</div>
                        <div class="text-muted" style="font-size:11px;">{{ user.email }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-4">
            <div class="iset-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color: var(--iset-dark-blue);">📅 Événements récents</h5>
                    <a href="{{ path('app_admin_events') }}" style="color: var(--iset-blue); font-size:13px;">Voir tout →</a>
                </div>
                {% for event in recentEvents %}
                <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid var(--iset-border);">
                    <span class="small">{{ event.nomEvenement }}</span>
                    <span class="iset-badge" style="background: {{ event.status == 'validated' ? 'var(--iset-success)' : (event.status == 'rejected' ? 'var(--iset-red)' : 'var(--iset-warning)') }}; color: white; font-size:11px;">
                        {{ event.status }}
                    </span>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-4">
            <div class="iset-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color: var(--iset-dark-blue);">💼 Recrutements récents</h5>
                    <a href="{{ path('app_admin_recrutements') }}" style="color: var(--iset-blue); font-size:13px;">Voir tout →</a>
                </div>
                {% for recrutement in recentRecrutements %}
                <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid var(--iset-border);">
                    <span class="small">{{ recrutement.title }}</span>
                    <span class="iset-badge" style="background: {{ recrutement.status == 'validated' ? 'var(--iset-success)' : 'var(--iset-warning)' }}; color: white; font-size:11px;">
                        {{ recrutement.status }}
                    </span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Quick navigation #}
    <div class="iset-card p-4">
        <h5 class="fw-bold mb-4" style="color: var(--iset-dark-blue);">⚡ Navigation rapide</h5>
        
        <div class="row g-3">
        <div class="col-md-3 col-6">
                <a href="{{ path('app_admin_club_members') }}" class="iset-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100" style="border: 1px solid var(--iset-border);">
                    <span style="font-size:1.75rem;">🤝</span>
                    <div>
                        <div class="fw-semibold small" style="color: var(--iset-dark-blue);">Adhésions</div>
                        {% if totalPendingClubMembers > 0 %}<div class="text-danger" style="font-size:11px;">{{ totalPendingClubMembers }} en attente</div>{% endif %}
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="{{ path('app_admin_users') }}" class="iset-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100" style="border: 1px solid var(--iset-border);">
                    <span style="font-size:1.75rem;">👥</span>
                    <div>
                        <div class="fw-semibold small" style="color: var(--iset-dark-blue);">Utilisateurs</div>
                        {% if totalPendingUsers > 0 %}<div class="text-danger" style="font-size:11px;">{{ totalPendingUsers }} en attente</div>{% endif %}
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="{{ path('app_admin_events') }}" class="iset-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100" style="border: 1px solid var(--iset-border);">
                    <span style="font-size:1.75rem;">📅</span>
                    <div>
                        <div class="fw-semibold small" style="color: var(--iset-dark-blue);">Événements</div>
                        {% if totalPendingEvents > 0 %}<div class="text-danger" style="font-size:11px;">{{ totalPendingEvents }} en attente</div>{% endif %}
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="{{ path('app_admin_clubs') }}" class="iset-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100" style="border: 1px solid var(--iset-border);">
                    <span style="font-size:1.75rem;">🏛️</span>
                    <div>
                        <div class="fw-semibold small" style="color: var(--iset-dark-blue);">Clubs</div>
                        {% if totalPendingClubs > 0 %}<div class="text-danger" style="font-size:11px;">{{ totalPendingClubs }} en attente</div>{% endif %}
                    </div>
                </a>
            </div>
            
            
            <div class="col-md-3 col-6">
                <a href="{{ path('app_admin_reclamations') }}" class="iset-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100" style="border: 1px solid var(--iset-border);">
                    <span style="font-size:1.75rem;">📋</span>
                    <div>
                        <div class="fw-semibold small" style="color: var(--iset-dark-blue);">Réclamations</div>
                        {% if totalPendingReclamations > 0 %}<div class="text-danger" style="font-size:11px;">{{ totalPendingReclamations }} en attente</div>{% endif %}
                    </div>
                </a>
            </div>
        </div>
    </div>

</div>
{% endblock %}