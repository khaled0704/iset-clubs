{% extends 'base.html.twig' %}

{% block title %}Modifier le club | ISET Clubs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="iset-form">
                <div class="text-center mb-4">
                    <span class="display-1">✏️</span>
                    <h1 class="display-5 fw-bold mt-2" style="color: var(--iset-dark-blue);">Modifier le club</h1>
                    <p class="text-muted">{{ club.name }}</p>
                </div>

                {{ include('club/_form.html.twig', {'button_label': 'Enregistrer'}) }}

                <div class="d-flex gap-2 justify-content-center mt-4">
                    <a href="{{ path('app_club_index') }}" class="btn-iset-outline text-decoration-none px-4 py-2">
                        ← Retour
                    </a>
                    {{ include('club/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}