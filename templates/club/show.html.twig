{% extends 'base.html.twig' %}

{% block title %}{{ club.name }} | ISET Clubs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
{% endblock %}

{% block body %}
<div class="container py-4">
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success border-0 shadow-sm">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning border-0 shadow-sm">{{ message }}</div>
    {% endfor %}

    <div class="iset-event-header">
        <div class="row align-items-center">
            <div class="col-md-3 text-center">
                {% if club.logo %}
                    <img src="{{ asset('uploads/clubs/' ~ club.logo) }}" 
                         class="rounded-circle" width="150" height="150" style="object-fit:cover; border: 4px solid white;">
                {% else %}
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                         style="width:150px;height:150px; background: rgba(255,255,255,0.2);">
                        <span class="text-white fs-1">🏛️</span>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-9">
                <h1 class="display-5 fw-bold">{{ club.name }}</h1>
                <div class="mt-2">
                    <span class="iset-badge iset-badge-tech" style="background: {{ club.status == 'active' ? 'var(--iset-success)' : 'var(--iset-warning)' }};">
                        {{ club.status }}
                    </span>
                    <span class="ms-2"><i class="bi bi-tag"></i> {{ club.domain }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-lg-8">
            <div class="iset-card p-4 mb-4">
                <h3 class="fw-bold mb-3" style="color: var(--iset-dark-blue);">
                    <i class="bi bi-info-circle"></i> À propos
                </h3>
                <p style="line-height: 1.7;">{{ club.description }}</p>
                
                {% if club.wbsite %}
                    <p><strong>🌐 Site web :</strong> <a href="{{ club.wbsite }}" target="_blank" style="color: var(--iset-blue);">{{ club.wbsite }}</a></p>
                {% endif %}
                
                <p><strong>📅 Créé le :</strong> {{ club.createdAt ? club.createdAt|date('d/m/Y') : '' }}</p>
                
                <p><strong>👑 Président :</strong>
                    {% set president = null %}
                    {% for member in club.clubMembers %}
                        {% if member.role == 'President' and member.status == 'approved' %}
                            {% set president = member %}
                        {% endif %}
                    {% endfor %}
                    {% if president %}
                        {{ president.user.firstname }} {{ president.user.lastname }}
                    {% else %}
                        <span class="text-muted">Non assigné</span>
                    {% endif %}
                </p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="iset-card p-4 mb-4 text-center">
                <h4 class="fw-bold mb-3">🤝 Rejoindre le club</h4>
                
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    {% if isMember %}
                        {% if isMember.status == 'pending' %}
                            <div class="alert alert-warning">
                                ⏳ Votre demande est en attente d'approbation
                            </div>
                        {% elseif isMember.status == 'approved' %}
                            <a href="{{ path('app_club_leave', {id: club.id}) }}" 
                               class="btn-iset-danger w-100 d-block text-decoration-none">Quitter le club</a>
                        {% endif %}
                    {% else %}
                        <a href="{{ path('app_club_join', {id: club.id}) }}" 
                           class="btn-iset-primary w-100 d-block text-decoration-none">Rejoindre le club</a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn-iset-outline w-100 d-block text-decoration-none">
                        🔐 Connectez-vous pour rejoindre
                    </a>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <div class="mt-3">
                        <a href="{{ path('app_club_edit', {'id': club.id}) }}" 
                           class="btn-iset-secondary w-100 d-block text-decoration-none mb-2">Modifier</a>
                        {{ include('club/_delete_form.html.twig') }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_club_index') }}" class="btn-iset-outline text-decoration-none px-4 py-2">
            ← Retour aux clubs
        </a>
    </div>
</div>
{% endblock %}