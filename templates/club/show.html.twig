{% extends 'base.html.twig' %}

{% block title %}{{ club.name }}{% endblock %}

{% block body %}
<div class="container mt-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}

    <div class="row">
        <div class="col-md-4 text-center">
            {% if club.logo %}
                <img src="{{ asset('uploads/clubs/' ~ club.logo) }}" 
                     class="rounded-circle mb-3" width="150" height="150" style="object-fit:cover">
            {% else %}
                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:150px;height:150px">
                    <span class="text-white fs-1">🏛️</span>
                </div>
            {% endif %}
            <h2>{{ club.name }}</h2>
            <span class="badge bg-{{ club.status == 'active' ? 'success' : 'warning' }}">
                {{ club.status }}
            </span>
        </div>

        <div class="col-md-8">
            <h4>À propos</h4>
            <p>{{ club.description }}</p>
            <p><strong>Domaine:</strong> {{ club.domain }}</p>
            {% if club.wbsite %}
                <p><strong>Site web:</strong> 
                    <a href="{{ club.wbsite }}" target="_blank">{{ club.wbsite }}</a>
                </p>
            {% endif %}
            <p><strong>Créé le:</strong> {{ club.createdAt ? club.createdAt|date('d/m/Y') : '' }}</p>

            <div class="mt-4">
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                {% if isMember %}
                    {% if isMember.status == 'pending' %}
                        <div class="alert alert-warning">
                            ⏳ Votre demande est en attente d'approbation
                        </div>
                    {% elseif isMember.status == 'approved' %}
                        <a href="{{ path('app_club_leave', {id: club.id}) }}" 
                        class="btn btn-danger">Quitter le club</a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_club_join', {id: club.id}) }}" 
                    class="btn btn-success">Rejoindre le club</a>
                {% endif %}
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                    Connectez-vous pour rejoindre
                </a>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_club_edit', {'id': club.id}) }}" 
                class="btn btn-warning ms-2">Modifier</a>
                {{ include('club/_delete_form.html.twig') }}
            {% endif %}
            </div>
        </div>
    </div>

    <a href="{{ path('app_club_index') }}" class="btn btn-secondary mt-4">← Retour</a>
</div>
{% endblock %}