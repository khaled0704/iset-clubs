{% extends 'base.html.twig' %}

{% block title %}S'inscrire | ISET Events{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/iset-theme.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="iset-form">
                <div class="text-center mb-4">
                    <span class="display-1">🎓</span>
                    <h1 class="display-5 fw-bold mt-2" style="color: var(--iset-dark-blue);">Créer un compte</h1>
                    <p class="text-muted">Rejoignez la plateforme ISET Clubs</p>
                </div>

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger border-0 shadow-sm" style="border-left: 5px solid var(--iset-red) !important;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(registrationForm, {'attr': {'class': 'mt-4'}}) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            {{ form_label(registrationForm.firstname, "Prénom", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                            {{ form_widget(registrationForm.firstname, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}})}}
                        </div>
                        <div class="col-md-6 mb-4">
                            {{ form_label(registrationForm.lastname, "Nom", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                            {{ form_widget(registrationForm.lastname, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}})}}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(registrationForm.email, "Adresse email", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'prenom.nom@iset.rnu.tn'}})}}
                    </div>

                    <div class="mb-4">
                        {{ form_label(registrationForm.plainPassword, "Mot de passe", {'label_attr': {'class': 'form-label fw-semibold'}})}}
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}})}}
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}})}}
                            {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation", {'label_attr': {'class': 'form-check-label'}})}}
                        </div>
                    </div>

                    <button type="submit" class="btn-iset-primary w-100 py-2">
                        ✨ Créer mon compte
                    </button>

                {{ form_end(registrationForm) }}

                <p class="text-center mt-4 text-muted">
                    Déjà un compte ? <a href="{{ path('app_login') }}" style="color: var(--iset-blue);">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}